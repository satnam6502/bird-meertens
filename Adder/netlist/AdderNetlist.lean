import Adder
import Std.Data.HashMap

/-!
# The derived adder, as Verilog

`claNet` builds the carry-lookahead adder from symbolic gates, using the same
`prefixNet` that the proofs are about. `claNet_correct` proves the netlist adds.
This executable names each distinct gate once and prints the netlist as a
Verilog module. It also prints a checker module, whose output `ok` is high when
the adder agrees with Verilog's own `+`. Run it from the repository root:

    lake exe adder_netlist        # 32 bits
    lake exe adder_netlist 64

It writes `Adder/netlist/sklansky_adder_<n>.v` and
`Adder/netlist/sklansky_adder_<n>_check.v`.
Then it prints the size and depth of the ripple-carry and Sklansky netlists.
Only the printing here is unverified; `make -C Adder/netlist equiv`
checks its output.
-/

open BirdMeertens BirdMeertens.Adder

namespace AdderNetlist

/-- The operand columns of an `n`-bit adder, as input signals. -/
def columns (n : Nat) : List (Sig × Sig) :=
  (List.range n).map fun i => (.input s!"a[{i}]", .input s!"b[{i}]")

/-- The gates named so far, and their Verilog declarations in order. -/
structure Netlist where
  names : Std.HashMap Sig String := {}
  lines : Array String := #[]

/-- The Verilog name of a signal. Each distinct gate becomes one wire, declared
after the wires it reads. -/
partial def name (s : Sig) : StateM Netlist String := do
  match s with
  | .input n => return n
  | .const b => return if b then "1'b1" else "1'b0"
  | _ =>
    if let some w := (← get).names.get? s then return w
    let (op, a, b) : String × Sig × Sig := match s with
      | .and a b => ("&", a, b)
      | .or a b => ("|", a, b)
      | .xor a b => ("^", a, b)
      | _ => panic! "not a gate"
    let x ← name a
    let y ← name b
    modifyGet fun st =>
      let w := s!"w{st.names.size}"
      (w, { names := st.names.insert s w, lines := st.lines.push s!"  wire {w} = {x} {op} {y};" })

/-- The number of gates on the longest path to a signal. -/
partial def depth (s : Sig) : StateM (Std.HashMap Sig Nat) Nat := do
  match s with
  | .input _ | .const _ => return 0
  | .and a b | .or a b | .xor a b =>
    if let some d := (← get).get? s then return d
    let d := max (← depth a) (← depth b) + 1
    modify (·.insert s d)
    return d

/-- The distinct gates and the depth of a netlist with these outputs. -/
def stats (outs : List Sig) : Nat × Nat :=
  let ((), st) := (outs.forM fun s => discard (name s)).run {}
  let (ds, _) := (outs.mapM depth).run {}
  (st.names.size, ds.foldl max 0)

/-- The `n`-bit carry-lookahead adder as a Verilog module. -/
def adderVerilog (n : Nat) : String := Id.run do
  let outs := claNet (.input "cin") (columns n)
  let (ws, st) := (outs.mapM name).run {}
  let (gates, dep) := stats outs
  let mut v := s!"// Generated by `lake exe adder_netlist {n}` from Adder/Adder.lean. Do not edit.
// The {n}-bit carry-lookahead adder `claNet`: generate and propagate per column,
// a Sklansky prefix network of {levels (n + 1)} levels, and one XOR per sum bit.
// {gates} two-input gates. The longest path passes through {dep} of them.
module sklansky_adder_{n} (
  input  wire [{n - 1}:0] a,
  input  wire [{n - 1}:0] b,
  input  wire        cin,
  output wire [{n - 1}:0] sum,
  output wire        cout
);
"
  for line in st.lines do
    v := v ++ line ++ "\n"
  for i in [0:n] do
    v := v ++ s!"  assign sum[{i}] = {ws[i]!};\n"
  return v ++ s!"  assign cout = {ws[n]!};\nendmodule\n"

/-- A checker: `ok` is high when the adder agrees with `+`. -/
def checkVerilog (n : Nat) : String :=
  s!"// Generated by `lake exe adder_netlist {n}`. Do not edit.
// `ok` is high when sklansky_adder_{n} agrees with Verilog's own `+`.
module sklansky_adder_{n}_check (
  input  wire [{n - 1}:0] a,
  input  wire [{n - 1}:0] b,
  input  wire        cin,
  output wire        ok
);
  wire [{n - 1}:0] sum;
  wire        cout;
  sklansky_adder_{n} dut (.a(a), .b(b), .cin(cin), .sum(sum), .cout(cout));
  assign ok = (\{cout, sum} == \{1'b0, a} + \{1'b0, b} + \{\{{n}\{1'b0}}, cin});
endmodule
"

def main (args : List String) : IO UInt32 := do
  let n := (args.head? >>= String.toNat?).getD 32
  if n == 0 then
    IO.eprintln "the width must be positive"
    return 1
  IO.FS.createDirAll "Adder/netlist"
  IO.FS.writeFile s!"Adder/netlist/sklansky_adder_{n}.v" (adderVerilog n)
  IO.FS.writeFile s!"Adder/netlist/sklansky_adder_{n}_check.v" (checkVerilog n)
  IO.println s!"wrote Adder/netlist/sklansky_adder_{n}.v and Adder/netlist/sklansky_adder_{n}_check.v\n"
  IO.println "| Width | Ripple gates | Ripple depth | Sklansky gates | Sklansky depth |"
  IO.println "|---|---|---|---|---|"
  for w in [8, 16, 32, 64] do
    let (rg, rd) := stats (rippleNet (.input "cin") (columns w))
    let (sg, sd) := stats (claNet (.input "cin") (columns w))
    IO.println s!"| {w} | {rg} | {rd} | {sg} | {sd} |"
  return 0

end AdderNetlist

def main (args : List String) : IO UInt32 := AdderNetlist.main args
